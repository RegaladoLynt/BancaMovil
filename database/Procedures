USE banca_digital;

DELIMITER $$

-- 1. Registrar nuevo cliente y su cuenta bancaria
CREATE PROCEDURE sp_registrar_cliente(
    IN p_dni CHAR(8),
    IN p_nombres VARCHAR(60),
    IN p_apellidos VARCHAR(60),
    IN p_celular CHAR(9),
    IN p_username VARCHAR(30),
    IN p_password VARCHAR(50),
    IN p_numero_cuenta VARCHAR(16),
    IN p_saldo_inicial DECIMAL(10,2),
    IN p_fecha DATE,
    OUT p_resultado VARCHAR(100)
)
BEGIN
    DECLARE v_id_usuario INT;
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_resultado = 'Error SQL: DNI o usuario duplicado.';
    END;

    START TRANSACTION;
        INSERT INTO usuarios (dni, nombres, apellidos, celular, username, password, rol, estado)
        VALUES (p_dni, p_nombres, p_apellidos, p_celular, p_username, p_password, 'CLIENTE', 'ACTIVO');

        SET v_id_usuario = LAST_INSERT_ID();

        INSERT INTO cuentas (id_usuario, numero_cuenta, tipo_cuenta, saldo, limite_diario, estado)
        VALUES (v_id_usuario, p_numero_cuenta, 'AHORRO', p_saldo_inicial, 1500.00, 'ACTIVA');

        IF p_saldo_inicial > 0 THEN
            INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
            VALUES (v_id_usuario, 'DEPOSITO', 'Apertura de cuenta en ventanilla', p_saldo_inicial, p_fecha, TRUE);
        END IF;
    COMMIT;
    SET p_resultado = 'OK';
END$$

-- 2. Operación de ventanilla (Depósito o Retiro)
CREATE PROCEDURE sp_operar_ventanilla(
    IN p_id_usuario INT,
    IN p_es_deposito BOOLEAN,
    IN p_monto DECIMAL(10,2),
    IN p_fecha DATE,
    OUT p_resultado VARCHAR(100),
    OUT p_nuevo_saldo DECIMAL(10,2)
)
BEGIN
    DECLARE v_saldo_actual DECIMAL(10,2);

    SELECT saldo INTO v_saldo_actual FROM cuentas WHERE id_usuario = p_id_usuario FOR UPDATE;

    IF v_saldo_actual IS NULL THEN
        SET p_resultado = 'El cliente no posee una cuenta activa.';
        SET p_nuevo_saldo = 0;
    ELSEIF NOT p_es_deposito AND v_saldo_actual < p_monto THEN
        SET p_resultado = 'Saldo insuficiente para realizar el retiro en ventanilla.';
        SET p_nuevo_saldo = v_saldo_actual;
    ELSE
        START TRANSACTION;
            IF p_es_deposito THEN
                SET p_nuevo_saldo = v_saldo_actual + p_monto;
                UPDATE cuentas SET saldo = p_nuevo_saldo WHERE id_usuario = p_id_usuario;
                INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
                VALUES (p_id_usuario, 'DEPOSITO', 'Depósito en ventanilla bancaria', p_monto, p_fecha, TRUE);
            ELSE
                SET p_nuevo_saldo = v_saldo_actual - p_monto;
                UPDATE cuentas SET saldo = p_nuevo_saldo WHERE id_usuario = p_id_usuario;
                INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
                VALUES (p_id_usuario, 'RETIRO', 'Retiro en ventanilla bancaria', p_monto, p_fecha, TRUE);
            END IF;
        COMMIT;
        SET p_resultado = 'OK';
    END IF;
END$$

-- 3. Transferencia entre cuentas
CREATE PROCEDURE sp_realizar_transferencia(
    IN p_id_emisor INT,
    IN p_cuenta_destino VARCHAR(16),
    IN p_monto DECIMAL(10,2),
    IN p_fecha DATE,
    OUT p_resultado VARCHAR(120)
)
BEGIN
    DECLARE v_id_receptor INT;
    DECLARE v_cuenta_origen VARCHAR(16);
    DECLARE v_saldo_origen DECIMAL(10,2);
    DECLARE v_limite_diario DECIMAL(10,2);
    DECLARE v_nombre_emisor VARCHAR(125);

    SELECT c.numero_cuenta, c.saldo, c.limite_diario, CONCAT(u.nombres, ' ', u.apellidos)
    INTO v_cuenta_origen, v_saldo_origen, v_limite_diario, v_nombre_emisor
    FROM cuentas c INNER JOIN usuarios u ON c.id_usuario = u.id_usuario
    WHERE c.id_usuario = p_id_emisor;

    SELECT id_usuario INTO v_id_receptor FROM cuentas WHERE numero_cuenta = p_cuenta_destino AND estado = 'ACTIVA';

    IF v_id_receptor IS NULL THEN
        SET p_resultado = 'La cuenta destino no existe o está bloqueada.';
    ELSEIF v_cuenta_origen = p_cuenta_destino THEN
        SET p_resultado = 'No puede transferir a su misma cuenta.';
    ELSEIF v_saldo_origen < p_monto THEN
        SET p_resultado = 'Saldo insuficiente para realizar la transferencia.';
    ELSE
        START TRANSACTION;
            UPDATE cuentas SET saldo = saldo - p_monto WHERE id_usuario = p_id_emisor;
            UPDATE cuentas SET saldo = saldo + p_monto WHERE id_usuario = v_id_receptor;

            INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
            VALUES (p_id_emisor, 'TRANSFERENCIA_ENVIADA', CONCAT('Transferencia enviada a ', p_cuenta_destino), p_monto, p_fecha, (p_monto <= v_limite_diario));

            INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
            VALUES (v_id_receptor, 'TRANSFERENCIA_RECIBIDA', CONCAT('Transferencia recibida de ', v_nombre_emisor), p_monto, p_fecha, TRUE);

            IF p_monto > v_limite_diario THEN
                INSERT INTO notificaciones (id_usuario_origen, mensaje, fecha_notificacion, leida)
                VALUES (p_id_emisor, CONCAT('[ALERTA SEGURIDAD] ', v_nombre_emisor, ' realizó transferencia inusual de S/. ', p_monto), p_fecha, FALSE);
            END IF;
        COMMIT;
        SET p_resultado = 'OK';
    END IF;
END$$

-- 4. Pago de servicios externos
CREATE PROCEDURE sp_pagar_servicio(
    IN p_id_usuario INT,
    IN p_detalle VARCHAR(200),
    IN p_monto DECIMAL(10,2),
    IN p_fecha DATE,
    OUT p_resultado VARCHAR(120)
)
BEGIN
    DECLARE v_saldo DECIMAL(10,2);
    SELECT saldo INTO v_saldo FROM cuentas WHERE id_usuario = p_id_usuario;

    IF v_saldo < p_monto THEN
        SET p_resultado = 'Saldo insuficiente para pagar el servicio.';
    ELSE
        START TRANSACTION;
            UPDATE cuentas SET saldo = saldo - p_monto WHERE id_usuario = p_id_usuario;
            INSERT INTO transacciones (id_usuario, tipo, detalle, monto, fecha_transaccion, visto_admin)
            VALUES (p_id_usuario, 'PAGO_SERVICIO', p_detalle, p_monto, p_fecha, TRUE);
        COMMIT;
        SET p_resultado = 'OK';
    END IF;
END$$

