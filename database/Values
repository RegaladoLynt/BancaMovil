-- Sincronizar saldos actuales al centavo con todo el historial
UPDATE cuentas c
SET saldo = (
    SELECT COALESCE(SUM(
        CASE 
            WHEN t.tipo IN ('DEPOSITO', 'TRANSFERENCIA_RECIBIDA', 'DESEMBOLSO') THEN t.monto
            ELSE -t.monto
        END
    ), 0)
    FROM transacciones t
    WHERE t.id_usuario = c.id_usuario
)
WHERE c.id_cuenta > 0;

